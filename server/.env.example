NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost
DATABASE_URL= # MongoDB connection string
CLIENT_URL=http://localhost:3000 # CORS origin

# Required — app fails to start without these
JWT_ACCESS_SECRET=change-this-to-a-random-string
JWT_REFRESH_SECRET=change-this-to-a-random-string

# Optional
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Upstash Redis (used by cache.ts, notification worker)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# BullMQ Redis (used by queue.ts — falls back to localhost:6379 if REDIS_URL is unset)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Postgres (used by pg.ts — pgTable in schema)
POSTGRES_DATABASE_URL=

# Push notifications (used by notification.service.ts)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=