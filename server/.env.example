NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost
DATABASE_URL= # MongoDB connection string
CLIENT_URL=http://localhost:3000

# Extra origins allowed to call the API with credentials (comma-separated).
# `*` may be used inside an entry to cover per-deployment preview URLs, e.g.
# ALLOWED_ORIGINS=https://my-app-*.vercel.app
# A standalone `*` is ignored: it would allow any site to send credentialed requests.
ALLOWED_ORIGINS=

# Required — app fails to start without these
JWT_ACCESS_SECRET=change-this-to-a-random-string
JWT_REFRESH_SECRET=change-this-to-a-random-string

# Optional (have defaults in code)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis (BullMQ queue — optional, falls back to localhost:6379)
REDIS_URL=

# Upstash Redis (cache + notifications — required)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
